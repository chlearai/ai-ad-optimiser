# Example environment variables for Railway
# Copy these into Railway Dashboard → Variables

# JWT secret for auth tokens
ADOPTIMA_JWT_SECRET=change-me-to-a-long-random-string

# Database: Supabase PostgreSQL (recommended for Railway)
# Format: postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres
# Use the Supabase Transaction Pooler URL, not the direct 5432 URL.
# If set, this takes priority over SQLite.
DATABASE_URL=

# SQLite fallback (local dev only)
ADOPTIMA_DB_PATH=/app/data/adoptima.db

# Host and port (Railway sets PORT automatically)
HOST=0.0.0.0
PORT=8000

# Public base URL for onboarding setup links
ADOPTIMA_PUBLIC_BASE_URL=https://your-railway-domain.up.railway.app

# Optional: disable scheduler in dev or keep enabled
# ADOPTIMA_SCHEDULER_ENABLED=true

# SMTP settings for Outlook onboarding invitation emails
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=your-outlook-email@domain.com
SMTP_PASS=your-outlook-app-password
SMTP_SENDER_NAME=ChlearSakhaaOps AI

# ---- Crash Club: Meta leads -> Google Sheets ----
# Meta ad account that runs Crash Club lead ads (must be granted to the system user)
CRASH_CLUB_AD_ACCOUNT=act_XXXXXXXXX
# Target Google spreadsheet id (the long id in the sheet URL)
CRASH_CLUB_SHEET_ID=
# Tab name to append lead rows into
CRASH_CLUB_SHEET_TAB=Crash Club Leads
# Service account JSON (inline JSON string or path to file). Share the sheet with the SA email.
CRASH_CLUB_GOOGLE_SA_JSON=
CRASH_CLUB_GOOGLE_SA_FILE=google_service_account.json
# Meta webhook verification (set URL to <base>/api/crashclub/webhook in Meta App > Webhooks)
CRASH_CLUB_WEBHOOK_VERIFY_TOKEN=crashclub_verify
CRASH_CLUB_WEBHOOK_APP_SECRET=
# Set false to disable the 5-minute scheduler job
CRASH_CLUB_SYNC_ENABLED=true

DATABASE_URL=postgresql://postgres.<project-ref>:<DB-PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres
